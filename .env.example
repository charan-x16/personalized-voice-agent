# Next.js server-only backend origin. Never prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
# Optional canonical browser origin for strict BFF mutation checks behind a proxy.
APP_ORIGIN=http://localhost:3000
# Optional comma-separated hostname allowlist applied before any WSS URL reaches the browser.
VOICE_WEBSOCKET_HOSTS=

# Top-level deployment reference. The API reads apps/api/.env when launched
# from apps/api; copy these backend values there for local development.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./svara.db
# Use verify-full for Supabase and postgresql+asyncpg:// for its DATABASE_URL.
DATABASE_SSL_MODE=disable
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1000000

# Only these top-level provider final-variable keys are persisted.
FINAL_VARIABLE_ALLOWLIST=order_reference,follow_up,resolution_code

# Development-only defaults. Replace both before any shared deployment.
SESSION_SECRET=development-session-secret-change-before-production
SESSION_TTL_MINUTES=15
COMPLETION_GRACE_MINUTES=60
SARVAM_TOOL_SECRET=development-tool-secret-change-before-production

VOICE_PROVIDER=mock
# These two flags are allowed only for a local SQLite database.
ENABLE_DEMO_AUTH=true
SEED_DEMO_DATA=true

# Server-only Sarvam credentials. Never prefix these with NEXT_PUBLIC_.
# Supplying them does not enable live sessions until the provisioned Sarvam
# session-bootstrap contract is implemented in the provider adapter.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
