APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./svara.db
# Use verify-full for Supabase and postgresql+asyncpg:// for its DATABASE_URL.
DATABASE_SSL_MODE=disable
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1000000

# Only these top-level provider final-variable keys are persisted.
FINAL_VARIABLE_ALLOWLIST=order_reference,follow_up,resolution_code

# Replace both before any shared deployment.
SESSION_SECRET=development-session-secret-change-before-production
SESSION_TTL_MINUTES=15
COMPLETION_GRACE_MINUTES=60
SARVAM_TOOL_SECRET=development-tool-secret-change-before-production

VOICE_PROVIDER=mock
# These two flags are allowed only for a local SQLite database.
ENABLE_DEMO_AUTH=true
SEED_DEMO_DATA=true

# Server-only values for the guarded Sarvam adapter. Setting them does not
# enable live sessions until the provisioned session contract is implemented.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
