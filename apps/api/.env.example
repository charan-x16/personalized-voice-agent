# Backend / FastAPI only. Copy this file to apps/api/.env.
#
# Put real secrets in apps/api/.env.local instead. That file is loaded after
# this one and wins on conflicts, so re-running `cp .env.example .env` never
# destroys configured credentials. Both files are gitignored.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./svara.db
# Use verify-full for Supabase and postgresql+asyncpg:// for its DATABASE_URL.
DATABASE_SSL_MODE=disable
# Supabase verify-full example: ./certs/supabase-prod-ca-2021.crt
DATABASE_CA_CERT_FILE=
# IPv4 Supabase session pooler example: aws-0-ap-southeast-2.pooler.supabase.com
DATABASE_POOLER_HOST=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_BODY_BYTES=1000000

# Only these top-level provider final-variable keys are persisted.
FINAL_VARIABLE_ALLOWLIST=order_reference,follow_up,resolution_code

# Replace both before any shared deployment.
SESSION_SECRET=development-session-secret-change-before-production
SESSION_TTL_MINUTES=15
COMPLETION_GRACE_MINUTES=60
SARVAM_TOOL_SECRET=development-tool-secret-change-before-production

VOICE_PROVIDER=mock
# These two flags are allowed only for a local SQLite database. Clerk is the
# normal authentication path; demo auth exists only for isolated API tests.
ENABLE_DEMO_AUTH=false
SEED_DEMO_DATA=true
# Optional: seed a customer profile for a real sign-in email so /v1/me resolves
# for your own identity-provider account. Leave blank to seed demo users only.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=Workspace Owner

# Required for Clerk bearer-token verification and one-time verified-email
# linking. Never expose this value to browser code. CLERK_JWT_KEY is optional
# and enables networkless JWT signature verification when configured.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=

# Server-only values for the official Sarvam Agents SDK adapter. A committed
# integer agent version is required for live sessions.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_AGENT_ID=
SARVAM_AGENT_VERSION=
# Browser-facing relay URL. Production must use WSS on the public API host.
VOICE_WEBSOCKET_PUBLIC_URL=ws://127.0.0.1:8000/v1/voice/stream
