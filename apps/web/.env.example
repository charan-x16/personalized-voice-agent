# Frontend / Next.js only. Copy this file to .env.local, or run `clerk env pull`.
# Next.js server-only backend origin. Never prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
# Optional canonical browser origin for strict BFF mutation checks behind a proxy.
APP_ORIGIN=http://localhost:3000
# Exact public API hostnames allowed for the browser voice relay. Loopback API
# hosts are automatically accepted during local development.
VOICE_WEBSOCKET_HOSTS=

# Optional public-only site metadata and support destinations.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_URL=

# Clerk's publishable key is safe for the browser. The secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Frontend behavior flags; keep these aligned with apps/api/.env.
APP_ENV=development
VOICE_PROVIDER=mock
