{
  "name": "svara-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @svara/web dev",
    "build": "pnpm --filter @svara/web build",
    "lint": "pnpm --filter @svara/web lint",
    "typecheck": "pnpm --filter @svara/web typecheck",
    "test:unit": "pnpm --filter @svara/web test:unit",
    "test:web": "pnpm --filter @svara/web test:unit",
    "test:api": "uv run --directory apps/api pytest",
    "api:export-openapi": "uv run --directory apps/api python scripts/export_openapi.py",
    "api:check-openapi": "uv run --directory apps/api python scripts/export_openapi.py --check",
    "check": "pnpm typecheck && pnpm lint && pnpm test:web && pnpm test:api && pnpm api:check-openapi && pnpm build",
    "dev:api": "uv run --directory apps/api uvicorn svara_api.main:app --reload"
  },
  "packageManager": "pnpm@11.9.0"
}
